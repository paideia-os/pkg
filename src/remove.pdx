// src/remove.pdx -- pkg.M2-004
// PkgRemove module: `pkg remove <name>` body.
//
// Scope
// -----
// Per r49-r50-plan.md §5.1 M2 line: "pkg remove writes the reverse-
// symlink undo record."  Design/tooling/plan.md I5 upgrade: every
// destructive op is reversible via `undo <cmd>` for a bounded window;
// remove additionally writes the target into the PdxFS trash subtree
// so `undo pkg remove <name>` can restore without a re-fetch.
//
// M2 lands the SHAPE of the remove pipeline with the same
// seam-discipline as install:
//
//   1. Read pos_ptrs[1] (name); pos_count must be 2.
//   2. Request a bounded-lifetime KIND_PDXFS_FILE(write, /pkgs) cap via
//      PkgElevate::pkg_elevate_request_pdxfs_write_pkgs (ENH-008 #33 --
//      same wrapper install uses; result in remove_parent_slot). Wired
//      ahead of the lookup gate closing so remove never gains a live
//      unelevated destructive path.
//   3. Look up the installed version via /system/packages/<name>-*
//      (STUB at M2 -- KIND_PDXFS_FILE has no readdir op; the M2 shape
//      hard-codes a lookup miss which fails-safe).
//   4. Open KIND_PDXFS_TXN(mode=DELETE) via TxnClient::txn_open (SEAM),
//      threading remove_parent_slot the same way install threads
//      install_parent_slot.
//   5. Serialise the reverse-symlink undo record into the process's
//      undo-scratch buffer (REAL byte layout at M2 -- shape is stable).
//   6. Move /pkgs/<name>-<version>/ into
//      /system/trash/<remove_id>-<name>-<version>/ via a per-file txn
//      write per the parent's FILE_INVENTORY (STUB at M2 -- one write
//      per record shape lives at M4 alongside the fixture manifest).
//   7. Write the undo record to /journal/pkg/remove-<remove_id>.pdxundo
//      (STUB at M2 -- KIND_PDXFS_FILE write op deferred to R42-PREP-007).
//   8. Commit txn.
//   9. Exit 0.
//
//   On failure: txn_abort; exit 1 (EXIT_OP_FAIL) with a diagnostic
//   naming the failing step.
//
// Undo-record byte layout (design/tooling/plan.md §6.4 companion to
// the manifest format at design/manifest-format.md). 64B header + a
// variable body of FILE_TRASH_ENTRY records:
//
//   [+0]  8B magic          "pdxundo\0"  = 0x006f_646e_7578_6470
//   [+8]  4B format_version 1
//   [+12] 4B header_flags   0
//   [+16] 8B remove_id      monotonic within a process
//   [+24] 8B removed_ns     wall-clock of the remove
//   [+32] 8B replay_deadline_ns  absolute deadline; after this the
//                                trash entry is GC'd and undo → ENOENT
//   [+40] 8B body_len       length in bytes of the FILE_TRASH_ENTRY seq
//   [+48] 8B body_sha3_lo   halves of sha3-256(body) -- integrity gate
//   [+56] 8B body_sha3_hi
//
// FILE_TRASH_ENTRY (mirrors design/manifest-format.md §4.3 FILE_
// INVENTORY): mode + original_path_len + trash_path_len + sha3-256(bytes)
// + original_path + trash_path.
//
// The M2 remove body writes the header (via ur_write_header below) and
// leaves the body-loop for M4 alongside the per-file tar walk (same
// data-shape as install's inventory walk, inverted). Serialization
// order matches the plan-doc §6.4 reverse-map obligation: `undo pkg
// remove <name>` reads the record, recovers pkg.tar shape from the
// trash paths, and reinstalls from the trash subtree without needing
// pkgs.paideia-os connectivity.
//
// paideia-as compliance -- same as PkgInstall.

module Remove = structure {

  // ---- Constants -------------------------------------------------------
  // "pdxundo\0" little-endian.
  pub let UR_MAGIC_QWORD    : u64 = 0x006F646E75786470
  pub let UR_FORMAT_VERSION : u64 = 1

  // Default 24-hour undo retention. Wall-clock ns per plan-doc
  // §6.4 default; M4 test harness can override via --retention.
  //   24 * 3600 * 1e9 = 86_400_000_000_000
  pub let UR_DEFAULT_RETENTION_NS : u64 = 86400000000000

  // ---- Return codes ---------------------------------------------------
  pub let UR_OK               : u64 = 0
  pub let UR_ERR_BUF_TOO_SMALL : u64 = 0xFFFFEB80
  pub let UR_ERR_BAD_ARG       : u64 = 0xFFFFEB81

  // ---- Diagnostic strings ---------------------------------------------
  pub let REMOVE_USAGE_MSG : [u8; 31] =
    "usage: pkg remove <name>\n(pkg)\n"
  pub let REMOVE_USAGE_MSG_LEN : u64 = 31

  pub let REMOVE_STAGE_MSG_1 : [u8; 27] =
    "pkg remove: removing name '"
  pub let REMOVE_STAGE_MSG_1_LEN : u64 = 27
  pub let REMOVE_STAGE_MSG_2 : [u8; 2] = "'\n"
  pub let REMOVE_STAGE_MSG_2_LEN : u64 = 2

  pub let REMOVE_ERR_LOOKUP : [u8; 63] =
    "pkg remove: /system/packages/ readdir unavailable at M2 (R42)\n\n"
  pub let REMOVE_ERR_LOOKUP_LEN : u64 = 63

  pub let REMOVE_ERR_TXN : [u8; 65] =
    "pkg remove: KIND_PDXFS_TXN unavailable (R42-PREP-007 required)\n\n"
  pub let REMOVE_ERR_TXN_LEN : u64 = 65

  pub let REMOVE_ERR_UNDO : [u8; 60] =
    "pkg remove: undo record write failed -- refuse per I5\n(pkg)\n"
  pub let REMOVE_ERR_UNDO_LEN : u64 = 60

  // ---- Remove-progress state (populated across the pipeline) ----------
  pub let mut remove_name_ptr     : u64 = uninit @align(8)
  pub let mut remove_id           : u64 = uninit @align(8)
  pub let mut remove_txn_slot     : u64 = uninit @align(8)
  pub let mut remove_step         : u64 = uninit @align(8)

  // ENH-008 (#33): parent_slot returned by PkgElevate::
  // pkg_elevate_request_pdxfs_write_pkgs. Mirrors install_parent_slot
  // in src/install.pdx -- 0 (PE_PARENT_UNAVAILABLE) until the elevate
  // broker is registered (paideia-os R48-PREP-005); a future real
  // txn_open(DELETE) call threads this slot the same way install's
  // txn_open does.
  pub let mut remove_parent_slot  : u64 = uninit @align(8)

  pub let REMOVE_STEP_NONE     : u64 = 0
  pub let REMOVE_STEP_ELEVATE  : u64 = 1
  pub let REMOVE_STEP_LOOKUP   : u64 = 2
  pub let REMOVE_STEP_TXN_OPEN : u64 = 3
  pub let REMOVE_STEP_UNDO     : u64 = 4
  pub let REMOVE_STEP_TRASH    : u64 = 5
  pub let REMOVE_STEP_COMMIT   : u64 = 6

  // Monotonic remove-id counter -- one per process invocation is enough
  // since pkg is a single-subcommand process at M2, but incrementing
  // supports the M4 test harness that calls pkg_remove_body multiple
  // times inside one test binary.
  pub let mut _remove_id_counter : u64 = uninit @align(8)

  // Undo-record scratch buffer -- 64B header + up to 4KiB body at M2
  // (deliberately small; the M4 fixture packages have <= 16 files).
  pub let mut _undo_scratch : [u8; 4160] = uninit @align(64)

  // M3-003: audit_id from AuditClient::audit_begin. See _install_audit_id
  // in src/install.pdx for the same discipline.
  pub let mut _remove_audit_id : u64 = uninit @align(8)

  // ==========================================================================
  // remove_reset() -> ()
  // ==========================================================================
  pub let remove_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pkg.M2-004 remove_reset, widened at ENH-008 (#33): zero every remove-progress slot, including remove_parent_slot so a leftover elevate grant from a previous call cannot leak into a fresh txn_open. _remove_id_counter is NOT zeroed here -- it is a process-lifetime monotonic; the M4 test harness resets it explicitly when it wants a clean slate. Leaf function.",
      block: {
        xor rax, rax;
        lea r11, [rip + remove_name_ptr];    mov [r11], rax;
        lea r11, [rip + remove_id];          mov [r11], rax;
        lea r11, [rip + remove_txn_slot];    mov [r11], rax;
        lea r11, [rip + remove_step];        mov [r11], rax;
        lea r11, [rip + remove_parent_slot]; mov [r11], rax;
        ret
      }
    }

  // ==========================================================================
  // remove_id_next() -> u64
  //
  // Bump the monotonic remove-id counter and return the new value.
  // Starting value 1 (0 is reserved for "no remove active"). Wrap is
  // unreachable at process lifetimes (2^64 removes per invocation).
  // ==========================================================================
  pub let remove_id_next : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pkg.M2-004 remove_id_next: fetch-and-add on _remove_id_counter. Not atomic (M2 single-thread) but the shape survives to multithread at M5+ where a lock-free fetch-add replaces the mov+add+mov triple. Leaf function.",
      block: {
        lea r11, [rip + _remove_id_counter];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;
        ret
      }
    }

  // ==========================================================================
  // ur_write_header(buf_ptr, remove_id, removed_ns, replay_deadline_ns,
  //                 body_len, body_sha3_ptr)
  //   -> UR_OK | UR_ERR_BAD_ARG
  //
  // Serialise the 64B pdxundo header at buf_ptr. Called by
  // pkg_remove_body after the trash body has been enumerated (its
  // sha3-256 known); the M2 stub-body variant passes body_len=0 +
  // body_sha3_ptr -> 16B of zero.
  //
  // -- TODO fix: original M2-004 shape took body_sha3_lo/body_sha3_hi
  //    as two separate u64 params (7 total). paideia-as 0.21.0's
  //    lambda arity cap is 6 params (System-V register-passed cap,
  //    P0276), so the two halves are now passed via a single pointer
  //    to a 16B buffer (body_sha3_ptr[0]=lo, body_sha3_ptr[8]=hi) and
  //    loaded here instead. No call site passes the old 7-arg shape
  //    (ur_write_header is not yet invoked from pkg_remove_body at
  //    M2/M3), so this is a signature-only change.
  //
  // Register plan (leaf):
  //   rdi = buf_ptr (untouched)
  //   rax = magic constant / field value
  //   r10 = mask constant
  //   r11 = LEA scratch / large-imm staging / sha3-half load
  // ==========================================================================
  pub let ur_write_header : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf_ptr: u64) (remove_id: u64) (removed_ns: u64) (replay_deadline_ns: u64) (body_len: u64) (body_sha3_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pkg.M2-004 ur_write_header: serialise the 64B pdxundo header. Layout mirrors design/manifest-format.md's manifest header shape (magic qword + version/flags qword + payload metadata) so a downstream tool that already speaks pdxsig can consume pdxundo with the same qword-load idiom. Every field is a qword store (four 4B fields packed as: format_version|header_flags in qword@8). Large immediates (magic quad) staged via r11. body_sha3_ptr[0]/[8] are loaded via r11 and stored at qword@48/@56 (arity reduced 7->6 for P0276; see TODO above). Leaf function. Labels: none.",
      block: {
        // qword@0: magic.
        mov r11, 0x006F646E75786470;         // UR_MAGIC_QWORD
        mov [rdi + 0], r11;

        // qword@8: format_version (low 32b) | header_flags (high 32b = 0).
        mov rax, 1;                          // format_version = 1
        mov [rdi + 8], rax;                  // header_flags = 0 by omission

        // qword@16: remove_id
        mov [rdi + 16], rsi;

        // qword@24: removed_ns
        mov [rdi + 24], rdx;

        // qword@32: replay_deadline_ns
        mov [rdi + 32], rcx;

        // qword@40: body_len
        mov [rdi + 40], r8;

        // qword@48: body_sha3_lo (loaded from body_sha3_ptr[0])
        mov r11, [r9 + 0];
        mov [rdi + 48], r11;

        // qword@56: body_sha3_hi (loaded from body_sha3_ptr[8])
        mov r11, [r9 + 8];
        mov [rdi + 56], r11;

        xor rax, rax;                        // UR_OK
        ret
      }
    }

  // ==========================================================================
  // pkg_remove_body() -> exit_code
  //
  // Full remove pipeline. Same seam-discipline as PkgInstall: every
  // seam that returns *_STUB gates the remove with EXIT_OP_FAIL and a
  // diagnostic naming the missing intrinsic. A silent "remove without
  // undo" would violate I5 (destructive-op reversibility).
  //
  // Register plan (five callee-save pushes = 40 bytes; rsp%16 flips 8->0
  // for every nested call):
  //   rbx = pos_ptrs[1] (package name)
  //   r12 = remove_id (assigned at step 1a)
  //   r13 = TXN slot (0 until opened)
  //   r14 = scratch for ManifestCodec-style seam returns
  //   r15 = exit code accumulator
  // ==========================================================================
  pub let pkg_remove_body : () -> u64 !{mem, sysreg} @{cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "pkg.M3-003 pkg_remove_body, widened at ENH-008 (#33): audit-first via AuditWire::audit_begin_op BEFORE any output. Broker unavailable -> exit 4 (ENH-003 #28) without touching stdout/stderr. audit_id lands in _remove_audit_id .bss so epilogue commits without register-pressure hassle. Effects tail widens to !{mem, sysreg} @{cap, sched} matching AuditClient / PkgElevate. Full pipeline (ENH-008 inserts the elevate stage ahead of lookup): pos_ptrs[1] check -> monotonic remove_id -> PkgElevate::pkg_elevate_request_pdxfs_write_pkgs (result in remove_parent_slot; 0 today, no output) -> lookup SEAM (no readdir at HEAD) -> txn_open(DELETE) -> serialise undo header + body -> trash-move SEAM -> txn_commit. Silent-remove-without-audit would violate I5 as well as I5's undo obligation; silent-remove-without-elevate would violate D4 (no ambient /pkgs write authority) the moment the lookup gate closes. Cleanup: txn_abort on any failure. Five callee-save pushes flip rsp%16 8->0. Labels prefixed pr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        call remove_reset;

        // ---- Audit-first (M3-003) --------------------------------------
        lea rdi, [rip + OP_NAME_REMOVE];
        xor rsi, rsi;                        // op_args (0 pre-arity-check)
        call audit_begin_op;
        cmp rax, 0;
        je  pr_broker_fail;
        lea r11, [rip + _remove_audit_id];
        mov [r11], rax;

        xor r12, r12;                        // remove_id
        xor r13, r13;                        // TXN slot
        xor r14, r14;                        // seam scratch
        xor r15, r15;                        // exit code = 0

        // Step 1: pos_count == 2 check.
        lea r11, [rip + pos_count];
        mov rax, [r11];
        cmp rax, 2;
        jne pr_usage_error;

        // Load pos_ptrs[1].
        lea r11, [rip + pos_ptrs];
        mov rbx, [r11 + 8];
        cmp rbx, 0;
        je  pr_usage_error;

        lea r11, [rip + remove_name_ptr];
        mov [r11], rbx;

        // Step 1a: assign remove_id.
        call remove_id_next;
        mov r12, rax;
        lea r11, [rip + remove_id];
        mov [r11], r12;

        // Step 1b: emit progress diagnostic.
        lea rdi, [rip + REMOVE_STAGE_MSG_1];
        mov rsi, 27;                         // REMOVE_STAGE_MSG_1_LEN
        call print_str;

        mov rdx, rbx;
      pr_name_walk:
        xor rax, rax;
        mov_b rax, [rdx];
        cmp rax, 0;
        je  pr_name_walk_done;
        add rdx, 1;
        jmp pr_name_walk;
      pr_name_walk_done:
        mov rdi, rbx;
        mov rsi, rdx;
        sub rsi, rbx;
        call print_str;

        lea rdi, [rip + REMOVE_STAGE_MSG_2];
        mov rsi, 2;                          // REMOVE_STAGE_MSG_2_LEN
        call print_str;

        // ---- ENH-008 (#33): elevate for KIND_PDXFS_FILE(write, /pkgs) --
        // Ask libpdx-elevate for the same bounded-lifetime /pkgs write
        // cap install requests, BEFORE the lookup/txn_open stages that
        // will consume it. remove is destructive (trash-move + DELETE
        // txn) and D4 forbids ambient write authority on /pkgs for any
        // mutating path, not install alone. Wired here -- ahead of the
        // /system/packages/ readdir gate closing -- so remove never
        // gains a live unelevated destructive path once that gate
        // lands; a silent grant-then-write ordering bug would be much
        // harder to catch after the fact than a stage that already
        // exists and simply returns 0 today. No output; result stored
        // in remove_parent_slot for the eventual txn_open(DELETE).
        mov r11, 1;                          // REMOVE_STEP_ELEVATE
        lea rax, [rip + remove_step];
        mov [rax], r11;

        call pkg_elevate_request_pdxfs_write_pkgs;
        lea r11, [rip + remove_parent_slot];
        mov [r11], rax;                      // 0 today; live slot post-M2

        // Step 2: lookup /system/packages/<name>-* -- SEAM.
        // KIND_PDXFS_FILE at HEAD has no readdir; this step
        // unconditionally refuses at M2 with a diagnostic naming the
        // missing substrate. M3 wires the readdir extension OR reads
        // /system/packages/index.pdxlist per architecture.md §M2.
        mov r11, 2;                          // REMOVE_STEP_LOOKUP
        lea rax, [rip + remove_step];
        mov [rax], r11;

        // Deliberate fall-through to the lookup-error branch. When
        // the substrate lands, this jmp is replaced with the real
        // lookup call and its refusal-path becomes conditional.
        jmp pr_err_lookup;

      // ==== error branches ====
      pr_usage_error:
        lea rdi, [rip + REMOVE_USAGE_MSG];
        mov rsi, 31;                         // REMOVE_USAGE_MSG_LEN
        call print_err;
        mov r15, 2;
        jmp pr_epilogue;

      pr_err_lookup:
        lea rdi, [rip + REMOVE_ERR_LOOKUP];
        mov rsi, 63;                         // REMOVE_ERR_LOOKUP_LEN
        call print_err;
        mov r15, 1;
        jmp pr_epilogue;

      pr_err_txn:
        lea rdi, [rip + REMOVE_ERR_TXN];
        mov rsi, 65;                         // REMOVE_ERR_TXN_LEN
        call print_err;
        mov r15, 1;
        jmp pr_epilogue;

      pr_err_undo:
        lea rdi, [rip + REMOVE_ERR_UNDO];
        mov rsi, 60;                         // REMOVE_ERR_UNDO_LEN
        call print_err;
        mov r15, 1;

      pr_epilogue:
        // If a txn was opened, abort it (best-effort).
        mov r11, 0xFFFFEA00;
        cmp r13, r11;
        jae pr_ep_return;
        cmp r13, 0;
        je  pr_ep_return;
        mov rdi, r13;
        call txn_abort;

      pr_ep_return:
        // ---- M3-003 audit_commit ---------------------------------------
        lea r11, [rip + _remove_audit_id];
        mov rdi, [r11];                      // audit_id
        mov rsi, r15;                        // exit_code
        call audit_commit_op;

        mov rax, r15;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pr_broker_fail:
        // I5 refusal: no output, no audit_commit; exit 4 (ENH-003 #28).
        mov rax, 4;                          // AUDIT_EXIT_BROKER_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}

// src/txn_client.pdx -- pkg.M3 (TXN wire-up)
// TxnClient module: userspace-side wrapper for KIND_PDXFS_TXN
// (paideia-os KindPdxfsTxn = 0x196) via three real syscalls now that
// R42-PREP-007 (#1629) landed at paideia-os HEAD:
//
//   * sys_pdxfs_txn_open  -- syscall #70 (constructor)
//   * PXT_OP_COMMIT       -- op 7 via sys_cap_invoke (syscall #4)
//   * PXT_OP_ABORT        -- op 8 via sys_cap_invoke (syscall #4)
//
// The M2 seam bodies returned TXN_STUB across the board because the
// KIND_PDXFS_TXN kernel-side minter had no user-facing entry point
// and cap_handler_pdxfs_txn only exposed the read-side QUERY ops.
// R42-PREP-007 flipped that: the constructor is exposed as syscall #70
// (paideia-os sys_pdxfs_txn_open.pdx) and the write-side ops (COMMIT,
// ABORT, CREATE, RENAME, UNLINK) are on the cap_invoke dispatcher.
// This module replaces every seam with the real syscall, keeps the
// TXN_STUB sentinel in the vocabulary so a caller that still catches
// it never faults, and preserves the M2 signature for txn_commit /
// txn_abort (one arg = slot). The txn_open signature widens to carry
// (parent_slot, mode, txn_id, wal_off) matching the syscall's ABI --
// the M2 call site in install.pdx moves in the same commit.
//
// Milestone binding
// -----------------
// M3 wire-through: every seam issues the intended syscall + translates
// kernel errno sentinels into TxnClient vocabulary.
//
//   txn_open  : (parent_slot, mode, txn_id, wal_off) -> slot | *_STUB
//                                                              | *_KERNEL
//                                                              | mint sentinel
//   txn_commit: (slot) -> TXN_OK | TXN_KERNEL | PXT_BAD_TRANSITION
//   txn_abort : (slot) -> TXN_OK | TXN_KERNEL | PXT_BAD_TRANSITION
//
// paideia-as compliance
// ---------------------
//   - Module TxnClient (PascalCase basename).
//   - No `test` mnemonic; every zero-check via cmp reg, 0.
//   - Every cmp reg,imm <= 0x7FFFFFFF (large-imm return codes staged
//     via r11).
//   - r11 scratch.
//   - Leaf functions; no callee-save touched.

module TxnClient = structure {

  // ---- Return codes ---------------------------------------------------
  pub let TXN_OK       : u64 = 0
  pub let TXN_STUB     : u64 = 0xFFFFEA80   // reserved for future seams
  pub let TXN_BAD_ROW  : u64 = 0xFFFFEA81
  pub let TXN_BAD_ARG  : u64 = 0xFFFFEA82
  pub let TXN_KERNEL   : u64 = 0xFFFFEA83   // cap_invoke returned a fault

  // R70.M1-005 (#22): PXT_OP_UNLINK exists and is REAL kernel-side
  // (paideia-os R52.M6-003 #1711 -- it durably appends a JOP_DENTRY_DEL
  // + JOP_INODE_WRITE pair under one txn_id), but it is NOT REACHABLE
  // from userspace: the op's operands (parent_inode, name_ptr,
  // name_len) travel out-of-band through the kernel-internal
  // `pdxfs_txn_stage_unlink_name(row_id, parent_inode, name_ptr,
  // name_len)` staging table, and that function has no syscall
  // binding at paideia-os HEAD (its own header flags this as a KNOWN
  // GAP: "no caller in this landing calls this function yet ...
  // flagged for whichever future issue wires a real vops/syscall path
  // to UNLINK"). cap_invoke's 3-register dispatch surface cannot carry
  // the operands inline -- op_arg's upper 56 bits are hard-refused by
  // cap_handler_pdxfs_txn for EVERY op.
  //
  // This sentinel is what txn_unlink returns instead of issuing the
  // cap_invoke. Issuing it would be strictly worse than refusing: an
  // unstaged row reads back parent_inode = 0 / name_ptr = 0 /
  // name_len = 0, so the kernel would emit a dentry-delete against a
  // NULL name under the root inode -- a blind unlink whose target the
  // caller never named. Refusing keeps the I5 obligation intact (a
  // remove that cannot be performed exactly must refuse, not
  // approximate).
  pub let TXN_UNLINK_UNSTAGED : u64 = 0xFFFFEA84

  // ---- Op codes -- mirror kind_pdxfs_txn.pdx PXT_OP_* -----------------
  // Read-side (existing at paideia-os HEAD):
  pub let TXN_OP_QUERY_ID    : u64 = 0
  pub let TXN_OP_QUERY_SNAP  : u64 = 1
  pub let TXN_OP_QUERY_WAL   : u64 = 2
  pub let TXN_OP_QUERY_BYTES : u64 = 3
  pub let TXN_OP_QUERY_STATE : u64 = 4
  pub let TXN_OP_QUERY_MODE  : u64 = 5

  // Write-side (R42-PREP-007 landed):
  pub let TXN_OP_COMMIT      : u64 = 7
  pub let TXN_OP_ABORT       : u64 = 8
  pub let TXN_OP_CREATE      : u64 = 9
  pub let TXN_OP_RENAME      : u64 = 10
  pub let TXN_OP_UNLINK      : u64 = 11

  // ---- Syscall ids ----------------------------------------------------
  pub let SYS_CAP_INVOKE      : u64 = 4
  pub let SYS_PDXFS_TXN_OPEN  : u64 = 70

  // ---- Modes (mirror KindPdxfsTxn PXT_MODE_*) -------------------------
  pub let TXN_MODE_CREATE : u64 = 1
  pub let TXN_MODE_MODIFY : u64 = 2
  pub let TXN_MODE_DELETE : u64 = 3

  // ---- Slot / errno taxonomy discriminators ---------------------------
  // A successful sys_pdxfs_txn_open returns cap_slot in [0, 256). Any
  // rax >= 256 is either a mint sentinel (0xFFFFEC1x band) or -ENFILE
  // (0xFFFFFFFFFFFFFFDF). Callers gate on `jae 256` to branch to the
  // refusal path uniformly, matching sys_pdxfs_txn_open's own contract.
  pub let TXN_SLOT_CAP_MAX : u64 = 256

  // ==========================================================================
  // txn_query_state(slot) -> state_byte | TXN_KERNEL
  //
  // Read the transaction state via cap_invoke(slot, PXT_OP_QUERY_STATE).
  // Unchanged from M2 -- the read-side op exists at paideia-os HEAD.
  //
  // User-side syscall convention (matches every cap_invoke wrapper):
  //   rdi = SYS_CAP_INVOKE (=4)   [syscall #]
  //   rsi = slot                   [maps to dispatcher rdi]
  //   rdx = op                     [maps to dispatcher rsi]
  //
  // Kernel returns in rax; INVOKE_DENIED (0xFFFFFFFFFFFFFFFD) or
  // INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC) are translated to TXN_KERNEL
  // so callers see one vocabulary for "the kernel refused."
  // ==========================================================================
  pub let txn_query_state : (u64) -> u64 !{mem, sysreg} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pkg.M3 txn_query_state (unchanged from M2): wraps cap_invoke(slot, PXT_OP_QUERY_STATE=4). Register shuffle caller-ABI (rdi=slot) -> syscall-ABI (rdi=sysno=4, rsi=slot, rdx=op=4). INVOKE_DENIED / INVOKE_UNSUPPORTED map to TXN_KERNEL. sysreg effect for SYSCALL rcx/r11 clobber. Labels prefixed tc_qs_.",
      block: {
        mov rsi, rdi;                        // slot into syscall arg1
        mov rdi, 4;                          // SYS_CAP_INVOKE
        mov rdx, 4;                          // PXT_OP_QUERY_STATE
        syscall;

        // Translate INVOKE_DENIED / INVOKE_UNSUPPORTED to TXN_KERNEL.
        mov r11, 0xFFFFFFFFFFFFFFFD;         // INVOKE_DENIED
        cmp rax, r11;
        je  tc_qs_kernel;
        mov r11, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        cmp rax, r11;
        je  tc_qs_kernel;

        ret;

      tc_qs_kernel:
        mov rax, 0xFFFFEA83;                 // TXN_KERNEL
        ret
      }
    }

  // ==========================================================================
  // txn_open(parent_slot, mode, txn_id, wal_off) -> cap_slot | sentinel
  //
  // Mint a new KIND_PDXFS_TXN cap and return the cap_table slot the
  // caller threads through subsequent txn_commit / txn_abort calls.
  //
  // Real wire-through via syscall #70 (paideia-os R42-PREP-007 #1629).
  //
  // Caller ABI (SysV, 4 args):
  //   rdi = parent_slot  (KIND_MEMORY cap w/ RIGHT_MINT over the mount
  //                       root -- obtained via libpdx-elevate on M3-004)
  //   rsi = mode         (TXN_MODE_CREATE / MODIFY / DELETE)
  //   rdx = txn_id       (FS-assigned, non-zero; pkg allocates one per
  //                       install/remove via install_id_next / remove_id_next)
  //   rcx = wal_off      (WAL byte offset for first record; 0 at M3)
  //
  // Syscall ABI (paideia-os dispatch shift, dispatch.pdx L1557-1566):
  //   syscall_dispatch(rdi=sysno, rsi=a0, rdx=a1, rcx=a2, r8=a3)
  //   dispatch_pdxfs_txn_open then shuffles rsi->rdi etc. Body wants
  //   (rdi=parent_slot, rsi=mode, rdx=txn_id, rcx=wal_off) at its
  //   entry -- our caller-ABI shift is r8=rcx, rcx=rdx, rdx=rsi,
  //   rsi=rdi, rdi=70 which lands the four args in the a0..a3
  //   positions the dispatch shim then re-shuffles.
  //
  // Return:
  //   rax in [0, 256)                            -- cap_slot (success)
  //   rax in 0xFFFFEC1x band                     -- mint sentinel (verbatim)
  //   rax == 0xFFFFFFFFFFFFFFDF (-ENFILE, -33)   -- cap_table full
  //
  // Errors propagate verbatim: pkg_install's diagnostic path names the
  // specific mint sentinel so an operator reading stderr knows whether
  // the elevate failed (BAD_PARENT), the txn_id counter wrapped
  // (BAD_ID), or the transaction table is full (TAIL_ENOSPC).
  //
  // Leaf function; sysreg effect for the SYSCALL rcx/r11 clobber.
  // ==========================================================================
  pub let txn_open : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (parent_slot: u64) (mode: u64) (txn_id: u64) (wal_off: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pkg.M3 txn_open: real wire-through to syscall #70 (paideia-os R42-PREP-007). Caller-ABI (rdi=parent_slot, rsi=mode, rdx=txn_id, rcx=wal_off) shifts to syscall-ABI (rdi=70, rsi=parent_slot, rdx=mode, rcx=txn_id, r8=wal_off) via a right-shift chain done in reverse order so no destination overwrites a needed source: mov r8, rcx; mov rcx, rdx; mov rdx, rsi; mov rsi, rdi; mov rdi, 70. Return propagates verbatim -- rax in [0, 256) is cap_slot, rax in 0xFFFFEC1x band is a mint sentinel, rax == -ENFILE (0xFFFFFFFFFFFFFFDF) is cap_table-full. Caller in install.pdx branches on `cmp rax, 256; jae err`. sysreg effect for SYSCALL rcx/r11 architectural clobber. Leaf function; no callee-save touched. Labels: none.",
      block: {
        mov r8,  rcx;                        // syscall arg 4 = wal_off
        mov rcx, rdx;                        // syscall arg 3 = txn_id
        mov rdx, rsi;                        // syscall arg 2 = mode
        mov rsi, rdi;                        // syscall arg 1 = parent_slot
        mov rdi, 70;                         // SYS_PDXFS_TXN_OPEN
        syscall;
        ret
      }
    }

  // ==========================================================================
  // txn_commit(slot) -> TXN_OK | TXN_KERNEL | PXT sentinel
  //
  // Commit the transaction via cap_invoke(slot, PXT_OP_COMMIT=7).
  // On success the row transitions OPEN -> COMMITTED and every write
  // staged through it becomes durable atomically.
  //
  // Return translation:
  //   0                                    -- TXN_OK (PXT_STATE_COMMITTED)
  //   INVOKE_DENIED (0xFFFFFFFFFFFFFFFD)   -- TXN_KERNEL (kind refused)
  //   INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC) -- TXN_KERNEL (op refused)
  //   any other 0xFFFFEB* / 0xFFFFEC*      -- verbatim (PXT_BAD_TRANSITION
  //                                           if the row was not OPEN)
  //
  // Leaf; sysreg effect for the SYSCALL clobber.
  // ==========================================================================
  pub let txn_commit : (u64) -> u64 !{mem, sysreg} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pkg.M3 txn_commit: real wire-through to cap_invoke(slot, PXT_OP_COMMIT=7). Signature unchanged from M2 (one arg = slot). Register shuffle mirrors txn_query_state: caller-ABI (rdi=slot) -> syscall-ABI (rdi=4, rsi=slot, rdx=7). Return translation: 0 -> TXN_OK verbatim; INVOKE_DENIED / INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFD/FC) -> TXN_KERNEL; any other value propagates verbatim so a PXT_BAD_TRANSITION on an already-committed row surfaces at the caller for the audit trail. Labels prefixed tc_cm_.",
      block: {
        mov rsi, rdi;                        // slot into syscall arg1
        mov rdi, 4;                          // SYS_CAP_INVOKE
        mov rdx, 7;                          // PXT_OP_COMMIT
        syscall;

        mov r11, 0xFFFFFFFFFFFFFFFD;         // INVOKE_DENIED
        cmp rax, r11;
        je  tc_cm_kernel;
        mov r11, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        cmp rax, r11;
        je  tc_cm_kernel;

        ret;

      tc_cm_kernel:
        mov rax, 0xFFFFEA83;                 // TXN_KERNEL
        ret
      }
    }

  // ==========================================================================
  // txn_abort(slot) -> TXN_OK | TXN_KERNEL | PXT sentinel
  //
  // Abort the transaction via cap_invoke(slot, PXT_OP_ABORT=8). Every
  // write staged through the txn is discarded; the row transitions
  // OPEN -> ABORTED. Called by pkg_install on any verify / extract
  // failure so a partially-written /pkgs/<name>-<version>/ never
  // becomes visible.
  //
  // Leaf; sysreg effect for the SYSCALL clobber.
  // ==========================================================================
  pub let txn_abort : (u64) -> u64 !{mem, sysreg} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pkg.M3 txn_abort: real wire-through to cap_invoke(slot, PXT_OP_ABORT=8). Mirror of txn_commit with rdx=8. Labels prefixed tc_ab_.",
      block: {
        mov rsi, rdi;                        // slot into syscall arg1
        mov rdi, 4;                          // SYS_CAP_INVOKE
        mov rdx, 8;                          // PXT_OP_ABORT
        syscall;

        mov r11, 0xFFFFFFFFFFFFFFFD;         // INVOKE_DENIED
        cmp rax, r11;
        je  tc_ab_kernel;
        mov r11, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        cmp rax, r11;
        je  tc_ab_kernel;

        ret;

      tc_ab_kernel:
        mov rax, 0xFFFFEA83;                 // TXN_KERNEL
        ret
      }
    }

  // ==========================================================================
  // txn_unlink(slot, path_ptr, path_len) -> TXN_OK
  //                                       | TXN_BAD_ARG
  //                                       | TXN_UNLINK_UNSTAGED
  //                                       | TXN_KERNEL
  //
  // R70.M1-005 (#22). Remove ONE path from within an already-open
  // KIND_PDXFS_TXN opened in TXN_MODE_DELETE. This is the
  // capability-correct deletion primitive for `pkg remove`: every file
  // the package installed is unlinked inside the SAME transaction, so
  // a failure partway through the file list aborts the whole set
  // rather than leaving a half-removed package on disk. A per-file
  // `sys_unlink` (syscall #81) loop would be the POSIX shape and is
  // explicitly NOT what this repo does -- see design/remove-flow.md
  // §8 for the rejection rationale (ambient authority vs. D4; no
  // atomicity vs. I5).
  //
  // CURRENT STATE: SEAM. See TXN_UNLINK_UNSTAGED above for why this
  // refuses rather than issuing cap_invoke(slot, PXT_OP_UNLINK). The
  // arguments are validated first so that the day paideia-os exposes
  // a staging syscall, the only edit here is replacing the refusal
  // with the two-call sequence:
  //
  //     mov rdi, <SYS_PDXFS_TXN_STAGE_UNLINK>;  // staging syscall
  //     mov rsi, <row_id from slot>;
  //     mov rdx, <parent_inode>;
  //     mov rcx, path_ptr;  mov r8, path_len;
  //     syscall;
  //     // then, exactly as txn_commit/txn_abort do:
  //     mov rsi, slot;  mov rdi, 4;  mov rdx, 11;  syscall;
  //
  // -- i.e. the cap_invoke half is already a solved shape in this
  // module; only the staging half is missing upstream.
  //
  // Argument validation is real today and worth keeping ahead of the
  // seam: a zero path_ptr or zero path_len is a caller bug that must
  // not be papered over by the seam's refusal, or it will resurface
  // as a blind unlink the moment the seam closes.
  //
  // Leaf function; no callee-save touched; no syscall issued today
  // (the sysreg effect is declared anyway so the signature does not
  // have to widen when the syscall lands).
  // ==========================================================================
  pub let txn_unlink : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (slot: u64) (path_ptr: u64) (path_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pkg.R70.M1-005 (#22) txn_unlink: per-file deletion inside an open TXN_MODE_DELETE transaction, the capability-correct replacement for a POSIX sys_unlink loop. Validates (slot < TXN_SLOT_CAP_MAX, path_ptr != 0, path_len != 0) then refuses with TXN_UNLINK_UNSTAGED because PXT_OP_UNLINK's operands travel through the kernel-internal pdxfs_txn_stage_unlink_name staging table, which has no syscall binding at paideia-os HEAD (#1711's own KNOWN GAP). Issuing cap_invoke(slot, 11) against an unstaged row would emit a dentry-delete for a NULL name under inode 0 -- a blind unlink -- so refusing is the I5-correct behaviour, not a convenience. Validation runs BEFORE the refusal deliberately so caller bugs surface now rather than at seam-close. slot bound-check uses cmp reg, 256 (imm32-safe, no r11 staging needed); the two large sentinels are returned via mov-imm which paideia-as encodes as a 64-bit load. Leaf; no callee-save touched. Labels prefixed tc_ul_.",
      block: {
        // Validate slot is a plausible cap_table slot.
        mov r11, 256;                        // TXN_SLOT_CAP_MAX
        cmp rdi, r11;
        jae tc_ul_bad_arg;

        // Validate the path operand pair.
        cmp rsi, 0;                          // path_ptr
        je  tc_ul_bad_arg;
        cmp rdx, 0;                          // path_len
        je  tc_ul_bad_arg;

        // SEAM: staging syscall absent upstream -- refuse rather than
        // issue a blind cap_invoke(slot, PXT_OP_UNLINK).
        mov rax, 0xFFFFEA84;                 // TXN_UNLINK_UNSTAGED
        ret;

      tc_ul_bad_arg:
        mov rax, 0xFFFFEA82;                 // TXN_BAD_ARG
        ret
      }
    }
}

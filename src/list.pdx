// src/list.pdx — pkg.M1-002
// PkgList module: `pkg list` body.
//
// Scope
// -----
// M1's first-runnable shape: `pkg list` walks the full dispatch chain
// (argv parse → subcommand recognize → this body → print → exit) and
// produces a header + a placeholder line on stdout.
//
// Why a placeholder rather than a live walk of /system/packages/:
//   KIND_PDXFS_FILE at the R48-close substrate exposes six query ops
//   (query_inode, query_len, query_mode, query_birth, query_mtime,
//   query_refs — src/kernel/core/cap/kind_pdxfs_file.pdx L94-100 in
//   paideia-os at commit 411ad0e) and no readdir op. The M1 substrate
//   cannot enumerate a directory. M2 either lands a readdir extension
//   on KIND_PDXFS_FILE or reads /system/packages/index.pdxlist (a text
//   file the pkg_install body maintains). That choice is a §5.1 M2
//   concern in design/tooling/r49-r50-plan.md, not an M1 one.
//
// M1's placeholder proves the print chain is wired end-to-end. When M2
// upgrades the enumerator, only pkg_list_enumerate changes — the
// header and the print-per-name loop stay.
//
// paideia-as compliance
// ---------------------
//   - Module PkgList (PascalCase basename).
//   - No test mnemonic; enumerate_count zero-check via cmp reg, 0.
//   - Every cmp reg, imm ≤ 0x7FFFFFFF.
//   - r11 is scratch (used in lea for the two .rodata strings).
//   - Function body issues nested calls to Print::print_str (2 pushes
//     of callee-save regs would be required if we crossed a call with
//     live state; the M1 body keeps state in .bss instead).

module PkgList = structure {

  // -- M1 output strings -------------------------------------------------
  // Header printed first. The trailing NUL is not emitted (len bounds
  // the sys_write payload); it is present so the .rodata blob is a
  // valid C-string for potential future strlen-style consumers.
  pub let LIST_HEADER : [u8; 20]     = "installed packages:\n"
  pub let LIST_HEADER_LEN : u64      = 20

  // M1 placeholder line. Kept obvious and dev-facing — a user reading
  // this in stdout during M1 gets an immediate handle on why the list
  // is empty and where in the roadmap the real enumerator lives.
  pub let LIST_PLACEHOLDER : [u8; 62] =
    "  (none — pkg list wires to /system/packages/ readdir at M2)\n"
  pub let LIST_PLACEHOLDER_LEN : u64 = 62

  // M3-001: demo package name emitted as a PackageManifest[] record so
  // a downstream consumer scanning for the schema hash sees at least
  // one row on `pkg list`. The name matches the self-install bootstrap
  // (pkg.M2-005) so a caller reading both the M3 record stream and
  // the M2 self-install log sees the same identifier.
  pub let LIST_DEMO_PKG_NAME     : [u8; 3] = "pkg"
  pub let LIST_DEMO_PKG_NAME_LEN : u64     = 3

  // M3-001 diagnostic emitted after the record stream when the schema
  // bind fails -- a supervisor grep sees the record stream broken by
  // the diagnostic rather than a silent gap.
  pub let LIST_SCHEMA_BIND_FAIL : [u8; 64] =
    "pkg list: PackageManifest schema bind failed (see errno on rc)\n\n"
  pub let LIST_SCHEMA_BIND_FAIL_LEN : u64 = 64

  // -- M1 enumeration state (stub) --------------------------------------
  // pkg_list_enumerate populates enumerated_count with the number of
  // installed packages. At M1 the enumerator is a stub that leaves the
  // count at zero (see the M2 note above); the body still calls it so
  // the M2 upgrade is a body edit inside pkg_list_enumerate rather
  // than a change to pkg_list_body.
  pub let mut enumerated_count : u64 = uninit @align(8)

  // ============================================================================
  // list_reset()
  //
  // Signature: list_reset : () -> () !{mem} @{}
  //
  // Clear enumerated_count so a subsequent pkg_list_body call starts
  // from a known-zero baseline. Kept as a distinct entry point so
  // pkg_main can invoke it at the top of dispatch without knowing the
  // module's internal .bss layout.
  //
  // Leaf function; r11 scratch; no callee-save touched.
  // ============================================================================
  pub let list_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pkg.M1-002 list_reset. Zero the enumerated_count .bss slot so pkg_list_body starts from a known baseline. Mirror of libpdx-argv ParsedArgs::reset shape. Leaf function; r11 is scratch used only for the lea; xor rax,rax is one byte cheaper than mov rax,0 and produces the same result.",
      block: {
        xor rax, rax;
        lea r11, [rip + enumerated_count];
        mov [r11], rax;
        ret
      }
    }

  // ============================================================================
  // pkg_list_enumerate() -> count
  //
  // Signature: pkg_list_enumerate : () -> u64 !{mem} @{}
  // RAX (output): number of installed packages discovered
  //
  // M1 body: STUB. Always returns 0. The enumerated_count slot is
  // populated so pkg_list_body's loop skip is data-driven rather than
  // return-value-driven — this matches the M2 shape where the
  // enumerator writes name pointers into a .bss table and returns the
  // count.
  //
  // M2 body: opens the KIND_PDXFS_FILE cap for /system/packages/ from
  // the InitCap sidecar, enumerates children via readdir (once
  // paideia-os exposes it) OR opens /system/packages/index.pdxlist
  // and parses line-by-line, writes each name pointer into a .bss
  // name table, and returns the count.
  //
  // Leaf function; r11 scratch; no callee-save touched.
  // ============================================================================
  pub let pkg_list_enumerate : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pkg.M1-002 pkg_list_enumerate STUB. Always returns 0 and writes 0 into enumerated_count. The write is redundant with list_reset (which pkg_main calls before this) but is present so a caller that skips list_reset still gets a known-zero baseline. M2 replaces the body with a live enumeration via KIND_PDXFS_FILE (paideia-os 0x195 substrate) — the signature stays u64 (count), the caller in pkg_list_body stays unchanged.",
      block: {
        xor rax, rax;
        lea r11, [rip + enumerated_count];
        mov [r11], rax;
        ret
      }
    }

  // ============================================================================
  // pkg_list_body() -> exit_code
  //
  // Signature: pkg_list_body : () -> u64 !{mem, sysreg} @{}
  // RAX (output): 0 on success (M1 always returns 0)
  //
  // M1 flow:
  //   1. Print the header "installed packages:\n" via Print::print_str
  //      (paideia-os sys_write to fd 1).
  //   2. Call pkg_list_enumerate → count. At M1 this is always 0.
  //   3. If count == 0, print the M1 placeholder line and exit 0.
  //   4. If count > 0 (M2+ path), fall through to the print-per-name
  //      loop. At M1 this branch is dead code; kept so the M2 patch
  //      is a body edit inside pkg_list_enumerate rather than a
  //      restructure of pkg_list_body.
  //
  // Prologue: 1 push (rbx). rsp % 16 was 8 on entry (SysV call), one
  // push brings it to 0 which satisfies the alignment invariant for
  // the two nested calls (Print::print_str, pkg_list_enumerate).
  // rbx holds the loop counter across print_str calls.
  //
  // Register plan:
  //   rbx = M2 loop counter (unused at M1 but preserved for the
  //          count>0 branch that lands then)
  //   rax = syscall/return value scratch
  //   rdi, rsi = print_str arguments
  //   r11 = lea scratch
  // ============================================================================
  pub let pkg_list_body : () -> u64 !{mem, sysreg} @{cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "pkg.M3-003 pkg_list_body. M3 upgrade over M1: (1) audit_begin_op BEFORE any stdout emission (I5 upgrade -- every operation is discoverable). (2) On broker unavailable (rax == 0), print refusal diagnostic + return AUDIT_EXIT_BROKER_FAIL (3) WITHOUT touching stdout; the diagnostic goes to stderr per D3. (3) Body proceeds as before; audit_commit_op at exit. Prologue widens to 2 pushes (rbx=exit code / rbx unused, r12=audit_id) leaving rsp%16 == 0 for every nested call. sysreg effect + cap+sched from AuditClient's tail. All immediates within cmp reg,imm <= 0x7FFFFFFF. Labels prefixed pl_.",
      block: {
        // Prologue: preserve rbx (M2 loop counter / unused at M3) +
        // r12 (audit_id across the body). rsp%16: 8 -> 0.
        push rbx;
        push r12;

        // ---- Audit-first (M3-003) --------------------------------------
        // audit_begin_op(OP_NAME_LIST, 0). Returns audit_id or 0.
        lea rdi, [rip + AuditWire::OP_NAME_LIST];
        xor rsi, rsi;                           // op_args = 0 (no positional)
        call AuditWire::audit_begin_op;
        cmp rax, 0;
        je  pl_broker_fail;
        mov r12, rax;                           // r12 = audit_id

        // ---- Body (unchanged from M1) ---------------------------------
        // Reset enumeration state up-front so a caller that runs
        // pkg_list_body twice in one process (shell subshell case)
        // sees a fresh count each time. Free-standing call, no args.
        call PkgList::list_reset;

        // Print the header. rdi = &LIST_HEADER, rsi = LIST_HEADER_LEN.
        lea rdi, [rip + LIST_HEADER];
        mov rsi, 20;                           // LIST_HEADER_LEN
        call Print::print_str;

        // ---- M3-001: schema bind + PackageManifest[] emit -------------
        // Bind stdout to PackageManifest schema first; a caller
        // consuming the schema-typed side of the pipe sees an
        // established binding before the first record lands. On bind
        // failure emit a stderr diagnostic + skip the emit; the text
        // side of the output still renders correctly.
        call PipeSchemas::ps_bind_pkg_manifest;
        cmp rax, 0;                            // PS_OK
        jne pl_bind_fail;

        // Emit ONE demo PackageManifest for "pkg" (matches the M2-005
        // self-install bootstrap identifier). M3 does not yet enumerate
        // /system/packages/ -- KIND_PDXFS_FILE.readnext (R42-PREP-008)
        // exists but pkg has no KIND_MEMORY cap for /system/packages/
        // seeded via InitCap at M3, so the demo emit is the D2 shape
        // in place while the enumerator's cap plumbing lands at M4.
        lea rdi, [rip + LIST_DEMO_PKG_NAME];
        mov rsi, 3;                            // LIST_DEMO_PKG_NAME_LEN
        call PipeSchemas::ps_emit_pkg_manifest;
        // Emit rc ignored -- a downstream schema consumer sees the
        // record or it does not; the text side (header + placeholder)
        // continues either way.

        jmp pl_bind_ok;

      pl_bind_fail:
        lea rdi, [rip + LIST_SCHEMA_BIND_FAIL];
        mov rsi, 64;                           // LIST_SCHEMA_BIND_FAIL_LEN
        call Print::print_err;

      pl_bind_ok:

        // Enumerate installed packages. Returns count in rax and also
        // populates enumerated_count. M1: stub always returns 0.
        call PkgList::pkg_list_enumerate;

        // Branch on count. cmp rax, 0 -> jne to the M2 print-loop
        // entry (dead code at M1). Fall-through prints the placeholder.
        cmp rax, 0;
        jne pkg_list_body_names_loop_head;

        // Zero-installed placeholder.
        lea rdi, [rip + LIST_PLACEHOLDER];
        mov rsi, 62;                           // LIST_PLACEHOLDER_LEN
        call Print::print_str;

        jmp pkg_list_body_done_ok;

      pkg_list_body_names_loop_head:
        // M2 entry. At M1 this label is reachable only if
        // pkg_list_enumerate returns non-zero, which the stub never
        // does. Deliberately empty at M1 -- a fall-through to
        // pkg_list_body_done_ok -- so the M2 patch adds the loop body
        // without moving any existing instruction.
        jmp pkg_list_body_done_ok;

      pkg_list_body_done_ok:
        // ---- Audit commit + exit-code 0 --------------------------------
        mov rdi, r12;                           // audit_id
        xor rsi, rsi;                           // exit_code = 0
        call AuditWire::audit_commit_op;
        xor rax, rax;                           // EXIT_OK
        pop r12;
        pop rbx;
        ret;

      pl_broker_fail:
        // I5 refusal path: no stdout emission, no audit_commit (the
        // audit was never begun). Exit AUDIT_EXIT_BROKER_FAIL (3).
        mov rax, 3;                             // AUDIT_EXIT_BROKER_FAIL
        pop r12;
        pop rbx;
        ret
      }
    }
}

// src/subcommands_m1_stubs.pdx — pkg.M1-002
// PkgSubcommandsM1 module: not-yet-implemented stubs for the four
// non-`list` subcommands recognised at M1.
//
// Scope
// -----
// M1's argv surface accepts five subcommand names: install, remove,
// list, verify, keys. Only `list` has a real body at M1 (see list.pdx);
// the other four are stubs here that print a diagnostic naming the
// milestone at which their real body lands and exit with the reserved
// code 3 (EXIT_NOT_YET_IMPLEMENTED).
//
// Recognising the subcommand-argv shape at M1 (rather than rejecting
// four of five with "unknown subcommand") lets a user or a downstream
// tool wire `pkg install foo` in a script today; the script rejects
// with an obvious message and a distinct exit code rather than
// pretending the vocabulary itself is wrong. Exit code 3 is chosen
// specifically so a caller can distinguish "the subcommand is not yet
// implemented" (3) from "usage error / unknown subcommand" (2) from
// "operation failed" (1).
//
// M2 lands the install and remove bodies (issues #4-#6 per the plan
// doc §5.1 milestone breakdown). M2 lands the verify body (part of
// #4). M5 lands the keys body (fingerprint listing off the M5
// paideia_root_pk documentation).
//
// paideia-as compliance
// ---------------------
//   - Module PkgSubcommandsM1 (PascalCase basename).
//   - No test mnemonic. Every leaf entry is a print + exit-code load.
//   - Every immediate is within cmp reg,imm ≤ 0x7FFFFFFF.
//   - r11 scratch; no callee-save touched.
//   - 1-push prologue (rbx unused body-side but keeps rsp%16 == 0 for
//     the nested Print::print_str call; a leaf-alignment discipline).

module PkgSubcommandsM1 = structure {

  // -- Exit code shared by all four stubs -------------------------------
  // Consumers (shell, test harness) match on 3 for the "not yet
  // implemented" case. 2 is reserved for usage errors (unknown
  // subcommand, missing positional); 1 is reserved for operation
  // failures that a real body encountered.
  pub let EXIT_NOT_YET_IMPLEMENTED : u64 = 3

  // -- Per-subcommand diagnostic strings --------------------------------
  // Each stub prints exactly one line so a script's stderr capture
  // stays scannable. The M-tag makes the message self-explaining
  // (a maintainer reading logs in six months knows which milestone
  // upgrades this line to a real body).
  pub let INSTALL_STUB_MSG : [u8; 52] =
    "pkg install: body not implemented at M1 (lands at M2)\n"
  pub let INSTALL_STUB_MSG_LEN : u64 = 52

  pub let REMOVE_STUB_MSG : [u8; 51] =
    "pkg remove: body not implemented at M1 (lands at M2)\n"
  pub let REMOVE_STUB_MSG_LEN : u64 = 51

  pub let VERIFY_STUB_MSG : [u8; 51] =
    "pkg verify: body not implemented at M1 (lands at M2)\n"
  pub let VERIFY_STUB_MSG_LEN : u64 = 51

  pub let KEYS_STUB_MSG : [u8; 49] =
    "pkg keys: body not implemented at M1 (lands at M5)\n"
  pub let KEYS_STUB_MSG_LEN : u64 = 49

  // ============================================================================
  // pkg_install_stub() -> exit_code
  //
  // Signature: pkg_install_stub : () -> u64 !{mem, sysreg} @{}
  // RAX (output): 3 (EXIT_NOT_YET_IMPLEMENTED)
  //
  // Body: 1 print + exit-code load. See the module preamble for the
  // rationale on why M1 recognises this subcommand rather than
  // rejecting it as unknown.
  //
  // Register plan (1-push prologue for alignment):
  //   rbx = unused; preserved for parity with the M2 body that reuses
  //          the same frame
  //   rax = return value
  //   rdi, rsi = print_str arguments
  //   r11 = lea scratch
  // ============================================================================
  pub let pkg_install_stub : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pkg.M1-002 pkg_install_stub. Prints INSTALL_STUB_MSG on stdout via Print::print_str and returns 3. 1-push prologue (rbx) aligns rsp%16 to 0 for the nested syscall. M2's pkg_install body replaces the body but keeps this signature so the dispatch call site in dispatch.pdx does not change.",
      block: {
        push rbx;
        lea rdi, [rip + INSTALL_STUB_MSG];
        mov rsi, 52;                            // INSTALL_STUB_MSG_LEN
        call Print::print_str;
        pop rbx;
        mov rax, 3;                             // EXIT_NOT_YET_IMPLEMENTED
        ret
      }
    }

  // ============================================================================
  // pkg_remove_stub() -> 3
  // ============================================================================
  pub let pkg_remove_stub : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pkg.M1-002 pkg_remove_stub. Same shape as pkg_install_stub with REMOVE_STUB_MSG. M2's pkg_remove body replaces the body; signature stays.",
      block: {
        push rbx;
        lea rdi, [rip + REMOVE_STUB_MSG];
        mov rsi, 51;                            // REMOVE_STUB_MSG_LEN
        call Print::print_str;
        pop rbx;
        mov rax, 3;
        ret
      }
    }

  // ============================================================================
  // pkg_verify_stub() -> 3
  // ============================================================================
  pub let pkg_verify_stub : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pkg.M1-002 pkg_verify_stub. Same shape as pkg_install_stub with VERIFY_STUB_MSG. M2's pkg_verify body replaces the body; signature stays.",
      block: {
        push rbx;
        lea rdi, [rip + VERIFY_STUB_MSG];
        mov rsi, 51;                            // VERIFY_STUB_MSG_LEN
        call Print::print_str;
        pop rbx;
        mov rax, 3;
        ret
      }
    }

  // ============================================================================
  // pkg_keys_stub() -> 3
  // ============================================================================
  pub let pkg_keys_stub : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pkg.M1-002 pkg_keys_stub. Same shape as pkg_install_stub with KEYS_STUB_MSG. M5's pkg_keys body (fingerprint listing off the paideia_root_pk documentation) replaces the body; signature stays.",
      block: {
        push rbx;
        lea rdi, [rip + KEYS_STUB_MSG];
        mov rsi, 49;                            // KEYS_STUB_MSG_LEN
        call Print::print_str;
        pop rbx;
        mov rax, 3;
        ret
      }
    }
}

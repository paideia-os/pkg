// src/main.pdx — pkg.M1-002
// PkgMain module: pkg_main(argc, argv) entry point.
//
// Scope
// -----
// The paideia-as loader stub reads argc/argv from the stack per the
// SysV/x86_64 convention and calls pkg_main(argc in rdi, argv in rsi);
// pkg_main's return value is the process exit code the loader stub
// passes to sys_exit (paideia-os syscall #60).
//
// Flow:
//   1. ParsedArgs::reset() — zero libpdx-argv's parse state.
//   2. Parser::parse_argv(argv, argc) — walk argv into ParsedArgs.
//      If it returns non-zero, print a short usage line on stderr
//      and return exit code 2 (usage error). M3-002 replaces the
//      hand-rolled diagnostic with a doc-back-end call.
//   3. Dispatch::dispatch_reset() — zero chosen_subcommand.
//   4. Load ParsedArgs::pos_count; if 0 → Dispatch::dispatch_no_
//      subcommand (which prints the usage line and returns 2).
//   5. Load ParsedArgs::pos_ptrs[0] and call Dispatch::dispatch_
//      subcommand(subcmd_ptr).
//   6. Return the dispatch call's exit code.
//
// paideia-as compliance
// ---------------------
//   - Module PkgMain (PascalCase basename).
//   - No test mnemonic; every zero-check via cmp reg, 0.
//   - Every cmp reg, imm ≤ 0x7FFFFFFF.
//   - r11 is scratch; used in every lea for the ParsedArgs .bss
//     externals and the .rodata parse-fail message.
//   - 2-push prologue (rbx, r12) preserves argc + argv across the
//     nested calls. rsp % 16 was 8 on entry (SysV call), two pushes
//     bring it to 8 — but the alignment invariant is 0 at the next
//     call site, so a third dummy push (or a `sub rsp, 8`) would be
//     needed. Instead, we structure the frame with 2 pushes + one
//     `sub rsp, 8` reserved pad so rsp%16 == 0 for every nested call.
//
// Cross-module externs consumed
// -----------------------------
//   ParsedArgs::reset            (libpdx-argv)
//   ParsedArgs::pos_count        (libpdx-argv .bss)
//   ParsedArgs::pos_ptrs         (libpdx-argv .bss, [u64;32])
//   ParsedArgs::ERR_OK           (libpdx-argv constant; 0)
//   Parser::parse_argv           (libpdx-argv)
//   Dispatch::dispatch_reset     (this repo)
//   Dispatch::dispatch_subcommand(this repo)
//   Dispatch::dispatch_no_subcommand (this repo)
//   Print::print_err             (this repo)

module Main = structure {

  // -- Local diagnostic strings -----------------------------------------
  // Emitted when libpdx-argv reports a parse error. M3-002 replaces
  // this with a `doc pkg --help` invocation; M1 keeps the message
  // small and hand-rolled so pkg has no dep on `doc` at M1.
  pub let PARSE_FAIL_MSG : [u8; 39] =
    "pkg: argv parse error (run 'pkg --help')\n"
  pub let PARSE_FAIL_MSG_LEN : u64 = 39

  // ============================================================================
  // pkg_main(argc, argv) -> exit_code
  //
  // Signature: pkg_main : (u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): argc — number of argv entries
  // RSI (input): argv — pointer to a u64 array of NUL-terminated arg ptrs
  // RAX (output): exit code (0 ok / 1 op-fail / 2 usage / 3 not-yet-impl)
  //
  // Register plan (2-push + 8-byte reserved pad frame):
  //   rbx = argv        (preserved across every nested call)
  //   r12 = argc        (preserved across every nested call)
  //   [rsp + 0] = pad   (keeps rsp%16 == 0 at every nested call site)
  //   rax = call return / temp
  //   rdi, rsi = nested-call arg carriers
  //   r11 = lea scratch
  //
  // rsp arithmetic:
  //   caller-of-pkg_main:  rsp % 16 == 0 immediately before call
  //   after CALL:          rsp % 16 == 8  (return address pushed)
  //   after push rbx:      rsp % 16 == 0
  //   after push r12:      rsp % 16 == 8
  //   after sub rsp, 8:    rsp % 16 == 0  ← every nested call ok
  //   epilogue reverses.
  // ============================================================================
  pub let pkg_main : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (argc: u64) (argv: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pkg.M1-002 pkg_main. Entry point invoked by the paideia-as loader stub with argc in rdi + argv in rsi. Flow: parse via libpdx-argv → dispatch on ParsedArgs::pos_ptrs[0]. 2-push prologue (rbx=argv, r12=argc) plus a `sub rsp, 8` reserved pad keeps rsp%16 == 0 at every nested call site (Parser::parse_argv, ParsedArgs::reset, Dispatch::*, Print::print_err). rbx/r12 preserved across every nested call — the callee-save contract from SysV holds through libpdx-argv (see its Parser::parse_argv justification which declares leaf semantics). Parse-fail path: print PARSE_FAIL_MSG on stderr; return EXIT_USAGE. Zero-positional path: delegates to Dispatch::dispatch_no_subcommand which owns the usage-message print. Otherwise: dispatch on pos_ptrs[0]. All immediates within cmp reg,imm ≤ 0x7FFFFFFF. Return: pop the pad, pop r12, pop rbx, ret with rax carrying the dispatched body's exit code (or 2 on parse-fail).",
      block: {
        // Prologue: preserve argc/argv, align stack.
        push rbx;                              // rsp%16: 8 → 0
        push r12;                              // rsp%16: 0 → 8
        sub rsp, 8;                            // rsp%16: 8 → 0

        mov rbx, rsi;                          // rbx = argv
        mov r12, rdi;                          // r12 = argc

        // Step 1: reset libpdx-argv state.
        call reset;

        // Step 2: parse. rdi = argv, rsi = argc.
        mov rdi, rbx;
        mov rsi, r12;
        call parse_argv;

        // Step 3: check parse error. rax == 0 (ERR_OK) → continue.
        cmp rax, 0;
        je pkg_main_parse_ok;

        // Parse failed: print diagnostic, return EXIT_USAGE.
        lea rdi, [rip + PARSE_FAIL_MSG];
        mov rsi, 39;                           // PARSE_FAIL_MSG_LEN
        call print_err;

        mov rax, 2;                            // EXIT_USAGE
        jmp pkg_main_epilogue;

      pkg_main_parse_ok:
        // Step 4: reset dispatch state.
        call dispatch_reset;

        // Step 5: check pos_count. rax = ParsedArgs::pos_count.
        lea r11, [rip + pos_count];
        mov rax, [r11];
        cmp rax, 0;
        jne pkg_main_have_subcmd;

        // No subcommand supplied → print usage on stderr, return 2.
        call dispatch_no_subcommand;
        jmp pkg_main_epilogue;

      pkg_main_have_subcmd:
        // Step 6: dispatch on pos_ptrs[0].
        lea r11, [rip + pos_ptrs];
        mov rdi, [r11 + 0];                    // pos_ptrs[0] = subcmd name ptr
        call dispatch_subcommand;

      pkg_main_epilogue:
        // Restore stack, return with rax carrying the exit code.
        add rsp, 8;                            // undo pad
        pop r12;
        pop rbx;
        ret
      }
    }
}

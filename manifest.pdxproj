# pkg — paideia-as build manifest
#
# Wave: R49  Milestone: M4 (tests + smoke)
# Doc:   design/tooling/r49-r50-plan.md §5.1 in the paideia-os repo.
#
# Consumed by `paideia-as build`. Each line is a directive; blank lines
# and lines starting with `#` are ignored. The M1 format is deliberately
# minimal — one target, one entry point, a source list, a dep list, and
# the caps-manifest that ships in the packaged binary. paideia-as v0.33+
# is the required toolchain floor (mov_b narrow-load mnemonic + @align
# attribute on .bss slots per the #1248 mitigation).
#
# The build produces one output file at build-out/pkg (the elaborated
# .pdx → ELF-like Paideia binary) plus a caps-manifest copy at
# build-out/pkg.caps for the InitCap sidecar packaging step at M5.

name        = pkg
version     = 0.4.0-m4
kind        = tool
entry       = PkgMain::pkg_main
output      = build-out/pkg
caps_decl   = caps.decl

# --- Source list (order-insensitive; paideia-as resolves module deps
# from `module <Basename> = structure { ... }` headers). -----------------
sources:
  - src/print.pdx                 # sys_write(fd=1) helper
  - src/audit_wire.pdx            # libpdx-audit wire helper (M3-003)
  - src/pipe_schemas.pdx          # libpdx-semantic-pipe schema bind/emit (M3-001/M3-002)
  - src/pkg_elevate.pdx           # libpdx-elevate wrapper for /pkgs write (M3-004)
  - src/kind_package_manifest.pdx # KIND_PACKAGE_MANIFEST = 0x193 (M2-001)
  - src/kind_package_repo.pdx     # KIND_PACKAGE_REPO     = 0x192 (M2-002)
  - src/manifest_codec.pdx        # manifest.pdxsig decoder + verify seams (M2-003)
  - src/txn_client.pdx            # KIND_PDXFS_TXN userspace wrappers (M3 real syscall)
  - src/install.pdx               # `pkg install <name>` body (M2-003 + M3-003 audit)
  - src/remove.pdx                # `pkg remove <name>` body + undo (M2-004 + M3-003 audit)
  - src/subcommands_m1_stubs.pdx  # verify / keys stubs (M3-003 audit)
  - src/list.pdx                  # `pkg list` body (M1 + M3-001 schema + M3-003 audit)
  - src/dispatch.pdx              # subcommand recognizer + routing
  - src/main.pdx                  # pkg_main(argc, argv) entry point

# --- Library dependencies -----------------------------------------------
# Only libpdx-argv at M1 (subcommand recognizer uses it to parse flags).
# libpdx-audit lands at M3-003; libpdx-elevate at M3-004; libpdx-semantic-
# pipe at M3-001. libpdx-cap is not a direct dep at M1 — the exec-time
# manifest verify against caps.decl is loader-side, not tool-side, until
# libpdx-cap.M2 lands the CAP_MANIFEST_MISSING / EXTRA logic.
deps:
  - libpdx-argv @ ^0.1
  - libpdx-audit @ ^0.2           # M3-003: pre-output journal on every subcommand
  - libpdx-semantic-pipe @ ^0.2   # M3-001 + M3-002: schema-typed stdout for list + install
  - libpdx-elevate @ ^0.2         # M3-004: KIND_PDXFS_FILE(write,/pkgs) 60s window

# --- Paideia-as compliance flags ---------------------------------------
# These mirror the invariants every R49 tool observes and every M1 file
# in this repo is written against. Documented here so a build under a
# non-conforming paideia-as revision refuses fast.
compliance:
  - module-basename-pascal        # Module <BasenamePascalCase>, no dir prefix
  - no-test-mnemonic              # zero-check via cmp reg, 0
  - cmp-imm32-only                # cmp reg, imm ≤ 0x7FFFFFFF; else stage via r11
  - r11-scratch                   # r11 is not preserved across calls
  - byte-load-zero-then-mov_b     # xor rax, rax; mov_b rax, [ptr]
  - sysv-push-pop-parity          # rsp % 16 == 0 at every nested call
